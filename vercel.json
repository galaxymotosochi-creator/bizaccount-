{
  "version": 2,
  "public": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dash-v2",
      "destination": "/dash-v2.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
